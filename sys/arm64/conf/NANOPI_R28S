# GENERIC-based configuration; supply the board DTB through the boot loader.
include GENERIC
ident NANOPI_R28S

options SOC_ROCKCHIP_RK3528

device hym8563
device gpiokeys
device rkrng
device rk3528_tsadc
device rk3528_otp_trim
device rk3528_wdt
device rk3528_usb2phy
device rkcrypto

# Populated eMMC through the standard MMC/GEOM stack.
device rk3528_sdhci

# Onboard RTL8111H: qualified automatic FIFO sizing.
envvar hw.re.rtl8168h_auto_fifo=1
