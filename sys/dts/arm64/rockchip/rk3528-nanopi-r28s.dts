// SPDX-License-Identifier: BSD-2-Clause
/*
 * Copyright (c) 2026 Hiroki Sato <hrs@FreeBSD.org>
 *
 * Base board description: memory, CPUs, interrupt controller and console.
 * UART0 retains a 24 MHz early-console clock and firmware reset state.
 * The SD card uses the firmware-enabled, always-on 3.3 V supply.
 */

/dts-v1/;

#include <dt-bindings/clock/rockchip,rk3528-cru.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "FriendlyElec NanoPi R28S";
	compatible = "friendlyelec,nanopi-r28s", "rockchip,rk3528";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&gic>;

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:1500000n8";
	};

	/* Exclude firmware below 2 MiB and the secure 0x08400000..0x08bfffff. */
	memory@200000 {
		device_type = "memory";
		reg = <0 0x00200000 0 0x08200000>,
		      <0 0x08c00000 0 0x37400000>;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0>;
			enable-method = "psci";
		};
		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <1>;
			enable-method = "psci";
		};
		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <2>;
			enable-method = "psci";
		};
		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <3>;
			enable-method = "psci";
		};
		cpu-map {
			cluster0 {
				core0 { cpu = <&cpu0>; };
				core1 { cpu = <&cpu1>; };
				core2 { cpu = <&cpu2>; };
				core3 { cpu = <&cpu3>; };
			};
		};
	};

	/* Cortex-A53 per-core PMU SPIs, as in the vendor board DT. */
	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <0 171 4>, <0 172 4>, <0 173 4>, <0 174 4>;
		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
	};

	psci {
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <1 13 0xf08>, <1 14 0xf08>,
		             <1 11 0xf08>, <1 10 0xf08>;
	};

	gic: interrupt-controller@fed01000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-controller;
		reg = <0 0xfed01000 0 0x1000>,
		      <0 0xfed02000 0 0x2000>,
		      <0 0xfed04000 0 0x2000>,
		      <0 0xfed06000 0 0x2000>;
		interrupts = <1 9 0xf08>;
	};

	uart0: serial@ff9f0000 {
		compatible = "snps,dw-apb-uart";
		reg = <0 0xff9f0000 0 0x100>;
		interrupts = <0 40 4>;
		clocks = <&cru SCLK_UART0>, <&cru PCLK_UART0>;
		clock-names = "baudclk", "apb_pclk";
		pinctrl-names = "default";
		pinctrl-0 = <&uart0_pins>;
		/* Early console runs before the clock provider attaches. */
		clock-frequency = <24000000>;
		reg-shift = <2>;
		reg-io-width = <4>;
		current-speed = <1500000>;
		status = "okay";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;

		sys-led {
			label = "sys_led";
			gpios = <&gpio4 8 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		led1 {
			label = "led1";
			gpios = <&gpio4 9 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		led2 {
			label = "led2";
			gpios = <&gpio4 11 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	pinctrl: pinctrl {
		compatible = "rockchip,rk3528-pinctrl";
		rockchip,grf = <&ioc>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		gpio4: gpio@ffb20000 {
			compatible = "rockchip,gpio-bank";
			reg = <0 0xffb20000 0 0x200>;
			interrupts = <0 78 4>;
			clocks = <&cru PCLK_GPIO4>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 128 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		pull_none: pull-none {
			bias-disable;
		};

		led_pins: led-pins {
			rockchip,pins = <4 8 0 &pull_none>,
			    <4 9 0 &pull_none>, <4 11 0 &pull_none>;
		};

		pull_up: pull-up {
			bias-pull-up;
		};

		uart0_pins: uart0-pins {
			/* DEBUG connector: GPIO4_C7 RX, GPIO4_D0 TX, mux 1. */
			rockchip,pins = <4 23 1 &pull_up>, <4 24 1 &pull_up>;
		};

		pull_up_drv2: pull-up-drv2 {
			bias-pull-up;
			drive-strength = <2>;
		};

		sd_pins: sd-pins {
			rockchip,pins = <2 0 1 &pull_up_drv2>,
			    <2 1 1 &pull_up_drv2>, <2 2 1 &pull_up_drv2>,
			    <2 3 1 &pull_up_drv2>, <2 4 1 &pull_up_drv2>,
			    <2 5 1 &pull_up_drv2>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ioc: syscon@ff540000 {
			compatible = "rockchip,rk3528-ioc-grf", "syscon";
			reg = <0 0xff540000 0 0x40000>;
		};

		cru: clock-controller@ff4a0000 {
			compatible = "freebsd,rk3528-r28s-uart-cru";
			reg = <0 0xff4a0000 0 0x21000>;
			#clock-cells = <1>;
		};

		sdmmc: mmc@ffc30000 {
			compatible = "rockchip,rk3528-dw-mshc",
			    "rockchip,rk3288-dw-mshc";
			reg = <0 0xffc30000 0 0x4000>;
			interrupts = <0 133 4>;
			clocks = <&cru HCLK_SDMMC0>, <&cru CCLK_SRC_SDMMC0>;
			clock-names = "biu", "ciu";
			pinctrl-names = "default";
			pinctrl-0 = <&sd_pins>;
			fifo-depth = <256>;
			bus-width = <4>;
			max-frequency = <25000000>;
			disable-wp;
			status = "okay";
		};
	};
};
