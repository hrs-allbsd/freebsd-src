// SPDX-License-Identifier: BSD-2-Clause
/*
 * Copyright (c) 2026 Hiroki Sato <hrs@FreeBSD.org>
 *
 * Base board description: memory, CPUs, interrupt controller and console.
 * UART0 retains a 24 MHz early-console clock and firmware reset state.
 * The SD card uses the firmware-enabled, always-on 3.3 V supply.
 */

/dts-v1/;

#include <dt-bindings/clock/rockchip,rk3528-cru.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "FriendlyElec NanoPi R28S";
	compatible = "friendlyelec,nanopi-r28s", "rockchip,rk3528";
	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&gic>;

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:1500000n8";
	};

	/* Exclude firmware below 2 MiB and the secure 0x08400000..0x08bfffff. */
	memory@200000 {
		device_type = "memory";
		reg = <0 0x00200000 0 0x08200000>,
		      <0 0x08c00000 0 0x37400000>;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0>;
			enable-method = "psci";
		};
		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <1>;
			enable-method = "psci";
		};
		cpu2: cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <2>;
			enable-method = "psci";
		};
		cpu3: cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <3>;
			enable-method = "psci";
		};
		cpu-map {
			cluster0 {
				core0 { cpu = <&cpu0>; };
				core1 { cpu = <&cpu1>; };
				core2 { cpu = <&cpu2>; };
				core3 { cpu = <&cpu3>; };
			};
		};
	};

	/* Cortex-A53 per-core PMU SPIs, as in the vendor board DT. */
	pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <0 171 4>, <0 172 4>, <0 173 4>, <0 174 4>;
		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
	};

	psci {
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <1 13 0xf08>, <1 14 0xf08>,
		             <1 11 0xf08>, <1 10 0xf08>;
	};

	gic: interrupt-controller@fed01000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <3>;
		#address-cells = <0>;
		interrupt-controller;
		reg = <0 0xfed01000 0 0x1000>,
		      <0 0xfed02000 0 0x2000>,
		      <0 0xfed04000 0 0x2000>,
		      <0 0xfed06000 0 0x2000>;
		interrupts = <1 9 0xf08>;
	};

	uart0: serial@ff9f0000 {
		compatible = "snps,dw-apb-uart";
		reg = <0 0xff9f0000 0 0x100>;
		interrupts = <0 40 4>;
		clocks = <&cru SCLK_UART0>, <&cru PCLK_UART0>;
		clock-names = "baudclk", "apb_pclk";
		pinctrl-names = "default";
		pinctrl-0 = <&uart0_pins>;
		/* Early console runs before the clock provider attaches. */
		clock-frequency = <24000000>;
		reg-shift = <2>;
		reg-io-width = <4>;
		current-speed = <1500000>;
		status = "okay";
	};

	user_keys: gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&user_key_pin>;

		user-c {
			label = "USER/C";
			gpios = <&gpio4 10 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_1>;
			debounce-interval = <50>;
			/* No autorepeat or power action; evdev button only. */
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;

		sys-led {
			label = "sys_led";
			gpios = <&gpio4 8 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		led1 {
			label = "led1";
			gpios = <&gpio4 9 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		led2 {
			label = "led2";
			gpios = <&gpio4 11 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	pinctrl: pinctrl {
		compatible = "rockchip,rk3528-pinctrl";
		rockchip,grf = <&ioc>;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		gpio4: gpio@ffb20000 {
			compatible = "rockchip,gpio-bank";
			reg = <0 0xffb20000 0 0x200>;
			interrupts = <0 78 4>;
			clocks = <&cru PCLK_GPIO4>;
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pinctrl 0 128 32>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};

		pull_none: pull-none {
			bias-disable;
		};

		user_key_pin: user-key-pin {
			rockchip,pins = <4 10 0 &pull_up>;
		};

		led_pins: led-pins {
			rockchip,pins = <4 8 0 &pull_none>,
			    <4 9 0 &pull_none>, <4 11 0 &pull_none>;
		};

		pull_up: pull-up {
			bias-pull-up;
		};

		uart0_pins: uart0-pins {
			/* DEBUG connector: GPIO4_C7 RX, GPIO4_D0 TX, mux 1. */
			rockchip,pins = <4 23 1 &pull_up>, <4 24 1 &pull_up>;
		};

		pull_none_drv2: pull-none-drv2 {
			bias-disable;
			drive-strength = <2>;
		};

		gmac_pins: gmac-pins {
			rockchip,pins = <3 14 2 &pull_none_drv2>,
			    <3 15 2 &pull_none_drv2>, <3 3 2 &pull_none>,
			    <3 2 2 &pull_none>, <3 18 2 &pull_none>,
			    <3 1 2 &pull_none_drv2>, <3 0 2 &pull_none_drv2>,
			    <3 16 2 &pull_none>, <3 5 2 &pull_none>,
			    <3 4 2 &pull_none_drv2>, <3 7 2 &pull_none>,
			    <3 6 2 &pull_none>, <3 9 2 &pull_none_drv2>,
			    <3 8 2 &pull_none_drv2>, <3 13 2 &pull_none_drv2>;
		};

		pcie_reset_pin: pcie-reset-pin {
			rockchip,pins = <4 16 0 &pull_none>;
		};

		gmac_reset_pin: gmac-reset-pin {
			rockchip,pins = <4 18 0 &pull_none>;
		};

		pull_up_drv2: pull-up-drv2 {
			bias-pull-up;
			drive-strength = <2>;
		};

		emmc_pins: emmc-pins {
			/* GPIO1_C4..D3 data, D4 CMD, D5 CLK, D7 strobe. */
			rockchip,pins = <1 20 1 &pull_up>, <1 21 1 &pull_up>,
			    <1 22 1 &pull_up>, <1 23 1 &pull_up>,
			    <1 24 1 &pull_up>, <1 25 1 &pull_up>,
			    <1 26 1 &pull_up>, <1 27 1 &pull_up>,
			    <1 28 1 &pull_up>, <1 29 1 &pull_none>,
			    <1 31 1 &pull_none>;
		};

		sd_pins: sd-pins {
			rockchip,pins = <2 0 1 &pull_up_drv2>,
			    <2 1 1 &pull_up_drv2>, <2 2 1 &pull_up_drv2>,
			    <2 3 1 &pull_up_drv2>, <2 4 1 &pull_up_drv2>,
			    <2 5 1 &pull_up_drv2>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		grf: syscon@ff300000 {
			compatible = "syscon", "simple-mfd";
			reg = <0 0xff300000 0 0x90000>;
		};

		gmac1: ethernet@ffbe0000 {
			compatible = "rockchip,rk3528-gmac";
			reg = <0 0xffbe0000 0 0x10000>;
			interrupts = <0 121 4>;
			rockchip,grf = <&grf>;
			clocks = <&cru CLK_GMAC1_SRC_VPU>,
			    <&cru PCLK_MAC_VPU>, <&cru ACLK_MAC_VPU>;
			clock-names = "stmmaceth", "pclk_mac", "aclk_mac";
			/* Raw index in this FreeBSD prototype CRU binding only. */
			resets = <&cru 453>;
			reset-names = "stmmaceth";
			phy-mode = "rgmii-rxid";
			clock_in_out = "output";
			tx_delay = <0x30>;
			/* Updated in place from public OTP ID before GMAC attach. */
			local-mac-address = [00 00 00 00 00 00];
			snps,mixed-burst;
			snps,pbl = <8>;
			phy-handle = <&phy1>;
			status = "okay";
			/* PHY supply is enabled by the boot firmware. */
			pinctrl-names = "default";
			pinctrl-0 = <&gmac_pins &gmac_reset_pin>;
			snps,reset-gpio = <&gpio4 18 GPIO_ACTIVE_LOW>;
			snps,reset-active-low;
			snps,reset-delays-us = <0 20000 100000>;
			mdio {
				compatible = "snps,dwmac-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
				phy1: ethernet-phy@1 {
					reg = <1>;
				};
			};
		};

		otp_trim: otp@ffce0000 {
			compatible = "freebsd,rk3528-r28s-otp-trim";
			freebsd,board-identity;
			freebsd,identity-gmac = <&gmac1>;
			reg = <0 0xffce0000 0 0x4000>;
			clocks = <&cru PCLK_OTPC_NS>, <&cru CLK_SBPI_OTPC_NS>,
			    <&cru CLK_USER_OTPC_NS>;
			clock-names = "apb", "sbpi", "usr";
			#address-cells = <1>;
			#size-cells = <1>;

			tsadc_trim_l: trim-l@44 {
				reg = <0x44 1>;
			};
			tsadc_trim_h: trim-h@45 {
				reg = <0x45 1>;
			};
		};

		tsadc: tsadc@ffad0000 {
			compatible = "freebsd,rk3528-r28s-tsadc";
			reg = <0 0xffad0000 0 0x400>;
			rockchip,grf = <&grf>;
			clocks = <&cru PCLK_TSADC>, <&cru CLK_TSADC>,
			    <&cru CLK_TSADC_TSEN>;
			clock-names = "apb_pclk", "tsadc", "tsadc_tsen";
			resets = <&cru 526>, <&cru 527>;
			nvmem-cells = <&tsadc_trim_l>, <&tsadc_trim_h>;
			nvmem-cell-names = "trim_l", "trim_h";
			freebsd,require-otp-trim;
			rockchip,hw-tshut-temp = <120000>;
			rockchip,hw-tshut-mode = <0>;
			rockchip,hw-tshut-polarity = <0>;
		};

		wdt: watchdog@ffac0000 {
			compatible = "freebsd,rk3528-r28s-wdt";
			reg = <0 0xffac0000 0 0x100>;
			clocks = <&cru TCLK_WDT_NS>, <&cru PCLK_WDT_NS>;
			clock-names = "tclk", "pclk";
			resets = <&cru 159>, <&cru 160>;
		};

		/* Firmware SCMI mailbox lies below the usable RAM banks. */
		scmi_shmem: scmi-shmem@10f000 {
			compatible = "arm,scmi-shmem";
			reg = <0 0x0010f000 0 0x100>;
		};

		scmi {
			compatible = "arm,scmi-smc";
			shmem = <&scmi_shmem>;
			arm,smc-id = <0x82000010>;
			#address-cells = <1>;
			#size-cells = <0>;

			scmi_clocks: protocol@14 {
				reg = <0x14>;
				#clock-cells = <1>;
			};
		};

		crypto@ffc40000 {
			compatible = "rockchip,crypto-v4";
			reg = <0 0xffc40000 0 0x2000>;
			interrupts = <0 19 4>;
			clocks = <&scmi_clocks SCMI_ACLK_CRYPTO>,
			    <&scmi_clocks SCMI_HCLK_CRYPTO>,
			    <&scmi_clocks SCMI_CORE_CRYPTO>;
			clock-names = "aclk", "hclk", "sclk";
			resets = <&cru 58>;
			reset-names = "crypto-rst";
		};

		ioc: syscon@ff540000 {
			compatible = "rockchip,rk3528-ioc-grf", "syscon";
			reg = <0 0xff540000 0 0x40000>;
		};

		cru: clock-controller@ff4a0000 {
			/* eMMC mode retains existing clocks and the crypto reset. */
			compatible = "freebsd,rk3528-r28s-emmc-cru";
			reg = <0 0xff4a0000 0 0x21000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		pcie: pcie@fe000000 {
			compatible = "freebsd,rk3528-r28s-pcie";
			device_type = "pci";
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			reg = <0 0xfe000000 0 0x400000>,
			    <0 0xfe4f0000 0 0x10000>,
			    <0 0xfc000000 0 0x100000>,
			    <0 0xffdc0000 0 0x1000>;
			reg-names = "dbi", "apb", "config", "phy";
			rockchip,grf = <&grf>;
			pinctrl-names = "default";
			pinctrl-0 = <&pcie_reset_pin>;
			reset-gpios = <&gpio4 16 GPIO_ACTIVE_LOW>;
			bus-range = <0 255>;
			num-lanes = <1>;
			ranges = <0x81000000 0 0xfc100000 0 0xfc100000 0 0x100000>,
			    <0x82000000 0 0xfc200000 0 0xfc200000 0 0x1e00000>;
			/* One soldered endpoint on INTA; no MSI provider. */
			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &gic 0 155 4>;
			clocks = <&cru PCLK_GPIO4>, <&cru ACLK_PCIE>,
			    <&cru HCLK_PCIE_SLV>, <&cru HCLK_PCIE_DBI>,
			    <&cru PCLK_CRU_PCIE>, <&cru CLK_PCIE_AUX>,
			    <&cru PCLK_PCIE>, <&cru PCLK_PCIE_PHY>,
			    <&cru PCLK_PIPE_GRF>, <&cru CLK_REF_PCIE_INNER_PHY>;
			clock-names = "gpio", "aclk", "hclk_slv", "hclk_dbi",
			    "pclk_cru", "aux", "pclk", "phy_apb", "pipe_grf", "refclk";
			assigned-clocks = <&cru CLK_REF_PCIE_INNER_PHY>;
			assigned-clock-parents = <&cru CLK_PPLL_100M_MATRIX>;
			resets = <&cru 481>, <&cru 483>, <&cru 486>, <&cru 482>;
			reset-names = "periph", "power_up", "phy_apb", "phy";
			/* The shared Naneng lane is dedicated to the RTL8111H. */
			status = "okay";
		};

		emmc: mmc@ffbf0000 {
			compatible = "rockchip,rk3528-dwcmshc";
			reg = <0 0xffbf0000 0 0x10000>;
			interrupts = <0 136 4>;
			clocks = <&cru CCLK_SRC_EMMC>, <&cru HCLK_EMMC>,
			    <&cru ACLK_EMMC>, <&cru BCLK_EMMC>, <&cru TCLK_EMMC>;
			clock-names = "core", "bus", "axi", "block", "timer";
			resets = <&cru 415>, <&cru 416>, <&cru 417>,
			    <&cru 418>, <&cru 419>;
			reset-names = "core", "bus", "axi", "block", "timer";
			pinctrl-names = "default";
			pinctrl-0 = <&emmc_pins>;
			rockchip,ioc = <&ioc>;
			/* Fixed VCC=3.3V and VCCQ=1.8V; no rail switching. */
			bus-width = <8>;
			max-frequency = <49500000>;
			freebsd,use-sdma;
			freebsd,use-hs-sdr;
			freebsd,use-ddr52;
			no-sd;
			no-sdio;
			non-removable;
			disable-wp;
			status = "okay";
		};

		sdmmc: mmc@ffc30000 {
			compatible = "rockchip,rk3528-dw-mshc",
			    "rockchip,rk3288-dw-mshc";
			reg = <0 0xffc30000 0 0x4000>;
			interrupts = <0 133 4>;
			clocks = <&cru HCLK_SDMMC0>, <&cru CCLK_SRC_SDMMC0>;
			clock-names = "biu", "ciu";
			pinctrl-names = "default";
			pinctrl-0 = <&sd_pins>;
			fifo-depth = <256>;
			bus-width = <4>;
			max-frequency = <25000000>;
			disable-wp;
			status = "okay";
		};
	};
};
